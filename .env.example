APP_URL=http://localhost:3000
AUTH_COOKIE_NAME=ghost_proofing_session
AUTH_SECRET=replace-with-32-plus-random-bytes
ADMIN_EMAIL=studio@example.com
ADMIN_PASSWORD=change-me-now

# Railway Postgres
DATABASE_URL=postgresql://postgres:password@host.railway.internal:5432/railway

# Vercel Blob is the default storage driver. If the Blob store is connected to
# the Vercel project, production deployments can use Vercel OIDC automatically.
STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_for_local_dev_or_non_oidc_runtime
BLOB_STORE_ID=store_replace_if_using_oidc_locally
BLOB_ENDPOINT=https://s3.example.com
BLOB_REGION=auto
BLOB_ACCESS_KEY_ID=replace-me
BLOB_SECRET_ACCESS_KEY=replace-me
BLOB_FORCE_PATH_STYLE=true
BLOB_ORIGINALS_BUCKET=ghost-proofing-originals
BLOB_PREVIEWS_BUCKET=ghost-proofing-previews

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_CURRENCY=usd

RESEND_API_KEY=re_replace_me
EMAIL_FROM=Ghost Proofing <receipts@example.com>
